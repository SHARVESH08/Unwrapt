# Copy to `.env` and fill in. Vite only exposes vars prefixed with VITE_.
# Both values come from Supabase → Project Settings → API.
# The publishable key is the PUBLIC client key — safe in the frontend (RLS protects data).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Google OAuth client id/secret are NOT set here — they go into the Supabase
# dashboard (Authentication → Providers → Google), never in the app.

# Google Drive API key — lets the builder list a shared folder's images.
# Create in Google Cloud Console → APIs & Services → Credentials → API key,
# enable the "Google Drive API", and restrict the key (HTTP referrers + Drive API).
# Public by design (listing only). Without it, givers paste direct image links.
VITE_GOOGLE_DRIVE_API_KEY=
